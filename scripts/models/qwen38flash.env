# Qwen3.8-Flash-Next: MoE, 125B total / 6B active (+51B n-gram embedding, +4B MTP), 512 experts, bf16,
# 360 GB, 262k context. vLLM offloads the n-gram embedding table to host RAM by default, leaving ~60 GiB
# of weights per GPU across one node of 4 GH200. Needs vLLM >= 0.30 (we use 0.33).
export MODEL_REPO="Qwen/Qwen3.8-Flash-Next"
export SERVED_NAME="qwen38flash"
export ARCH="Qwen4ExpForConditionalGeneration"
export MAX_LEN=262144
export NODES=1 TP=4 DP_PER_NODE=1 EP=1
export GPUS=4          # GPUs per node to request (billing is per GPU); must equal TP x DP_PER_NODE
# Flags from the vLLM recipe. The recipe says to keep --max-num-seqs 256 (smaller values hit a Mamba-cache
# capacity error); it comes last so it overrides the default of 64 in node_entry.sh.
export VLLM_EXTRA_ARGS="--max-num-seqs 256 --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3"
