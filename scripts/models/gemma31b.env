# Gemma 4 31B: dense, bf16, 62.6 GB, 262k context. Weights fit on one GPU (58 GiB), but 262k context needs 2.
export MODEL_REPO="google/gemma-4-31B"
export MODEL_REVISION="5bbc2fb1c1b2c611d06e3d9f23c170ba21659d89"   # pinned commit; the weights we benchmarked
export SERVED_NAME="gemma31b"
export ARCH="Gemma4ForConditionalGeneration"
export MAX_LEN=262144
# 2 GPUs (TP 2). On ONE GPU the weights (58 GiB) leave 24.5 GiB for KV cache, but a 262k-token context needs
# 33.3 GiB, so vLLM refuses to start (max context on 1 GPU would be ~147k).
export NODES=1 TP=2 DP_PER_NODE=1 EP=0
export TIME_LIMIT=00:30:00   # hard cap on the serve job
export GPUS=2          # GPUs PER NODE to request (billing is per GPU); must equal TP x DP_PER_NODE
# vLLM's gemma4 reasoning and tool-call parsers.
export VLLM_EXTRA_ARGS="--reasoning-parser gemma4 --tool-call-parser gemma4 --enable-auto-tool-choice"
