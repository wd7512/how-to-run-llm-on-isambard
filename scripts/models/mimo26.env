# MiMo-V2.6-Flash-RL (XiaomiMiMo): MoE, 256 routed experts, FP8 compute (mxfp4 storage), 178 GB, 1M context.
# The vLLM recipe wants >= ~208 GB of GPU memory (4 x H200); 4 x GH200 (384 GiB) is one node.
# Needs vLLM >= 0.31 for the mxfp4 weights (we use 0.33). The recipe recommends the -MOPD variant over this
# -RL checkpoint because -RL can loop on repeated tool calls; this preset runs the -RL one.
export MODEL_REPO="XiaomiMiMo/MiMo-V2.6-Flash-RL"
export MODEL_REVISION="f657ba2f7d24c9adc5730675baaa2d34de878a49"   # pinned commit; the weights we benchmarked
export SERVED_NAME="mimo26"
export ARCH="MiMoV2ForCausalLM"
export MAX_LEN=262144
export NODES=1 TP=4 DP_PER_NODE=1 EP=0
export TIME_LIMIT=00:30:00   # hard cap on the serve job
export GPUS=4          # GPUs PER NODE to request (billing is per GPU); must equal TP x DP_PER_NODE
# Flags from the vLLM recipe for this model.
export VLLM_EXTRA_ARGS="--trust-remote-code --generation-config vllm --tool-call-parser mimo --enable-auto-tool-choice --reasoning-parser mimo"
