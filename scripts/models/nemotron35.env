# NVIDIA Nemotron 3.5 Super VL 120B-A12B (BF16): hybrid Mamba-Transformer MoE, 512 experts, 249 GB, 1M context.
# The BF16 repo, not NVFP4: Hopper has no FP4 tensor cores. 249 GB over 4 x 96 GiB = ~58 GiB per GPU.
export MODEL_REPO="nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-BF16"
export MODEL_REVISION="fb0ee0bc6b3f70342afd8d84cb80dbadbaa8a1fe"   # pinned commit; the weights we benchmarked
export SERVED_NAME="nemotron35"
export ARCH="NemotronH_Omni_Reasoning_V3"
export MAX_LEN=262144
export NODES=1 TP=4 DP_PER_NODE=1 EP=0
export TIME_LIMIT=00:30:00   # hard cap on the serve job (first run: generous; tighten to 2.5x measured afterwards)
export STARTUP_DEADLINE_S=1500   # abort if the server is not up by then (first run: generous)
export GPUS=4          # GPUs PER NODE to request (billing is per GPU); must equal TP x DP_PER_NODE
# Flags from the vLLM recipe (without the multimodal and speculative-decoding options, which we do not measure).
export VLLM_EXTRA_ARGS="--trust-remote-code --async-scheduling --max-num-seqs 32 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser nemotron_v3"
