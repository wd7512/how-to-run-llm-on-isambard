# Qwen3.8-27B: dense 27B, bf16, 55.6 GB, 262k context. Fits on ONE GPU, so use
# a single replica on 1 GPU (billing is per GPU, so this costs a quarter of a full node).
# For more throughput raise GPUS and DP_PER_NODE together.
export MODEL_REPO="Qwen/Qwen3.8-27B"
export MODEL_REVISION="37561816e66b5b9153b1b64c10968c18c1e6f4a0"   # pinned commit; the weights we benchmarked
export SERVED_NAME="qwen38"
export ARCH="Qwen3_5ForConditionalGeneration"
export MAX_LEN=262144
export NODES=1 TP=1 DP_PER_NODE=1 EP=0
export TIME_LIMIT=00:30:00   # hard cap on the serve job
export GPUS=1          # GPUs PER NODE to request (billing is per GPU); must equal TP x DP_PER_NODE
# Flags from the vLLM recipe for this model.
export VLLM_EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --mm-encoder-tp-mode data"
