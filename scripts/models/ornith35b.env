# Ornith-1.0-35B (ornith-ai): MoE, 256 experts (8 active), ~35B total, bf16, 70.3 GB, 262k context, MIT.
# Qwen3.5-MoE architecture; needs vLLM >= 0.19.1 (we use 0.33).
export MODEL_REPO="ornith-ai/Ornith-1.0-35B"
export MODEL_REVISION="5df2ed3f675c7beaa490328cc70bb573b65fb660"   # pinned commit; the weights we benchmarked
export SERVED_NAME="ornith35b"
export ARCH="Qwen3_5MoeForConditionalGeneration"
export MAX_LEN=262144
# One GPU first (65 GiB of weights on a 96 GiB GPU); raise TP/GPUS to 2 if the KV cache is too small for 262k.
export NODES=1 TP=1 DP_PER_NODE=1 EP=0
export TIME_LIMIT=00:30:00   # hard cap on the serve job
export GPUS=1          # GPUs PER NODE to request (billing is per GPU); must equal TP x DP_PER_NODE
# Flags from the model card's vLLM recipe.
export VLLM_EXTRA_ARGS="--enable-prefix-caching --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3 --trust-remote-code"
