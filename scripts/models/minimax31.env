# MiniMax-M3.1-Flash (MiniMaxAI): sparse MoE (128 experts, 4 active), 252 GB, mxfp8 with NVFP4 experts, 1M context.
# Needs two nodes (see below). Needs vLLM >= 0.33 (the image has 0.33.0). Hopper has no FP4 tensor cores, so the NVFP4 experts use the Marlin MoE kernel.
export MODEL_REPO="MiniMaxAI/MiniMax-M3.1-Flash"
export MODEL_REVISION="ce7f4df87d2e05262f5775f373dac4772f134041"   # pinned commit; the weights we benchmarked
export SERVED_NAME="minimax31"
export ARCH="MiniMaxM3SparseForConditionalGeneration"
export MAX_LEN=262144
# TWO nodes: tensor-parallel 4 per node x data-parallel 2 + expert-parallel. On ONE node (TP 4) it ran out of memory while
# allocating weights (92 GiB per GPU and still going): vLLM picks the MXFP8 Marlin MoE path for this checkpoint and allocates
# the experts at 1 byte per parameter, far more than the 252 GB on disk. Expert-parallel over 8 GPUs spreads them.
export NODES=2 TP=4 DP_PER_NODE=1 EP=1
export TIME_LIMIT=00:20:00   # hard cap on the serve job (first run: generous; tighten to 2.5x measured afterwards)
export STARTUP_DEADLINE_S=900   # abort if the server is not up by then (first run: generous)
export GPUS=4          # GPUs PER NODE to request (billing is per GPU); must equal TP x DP_PER_NODE
export EXTRA_ENV="VLLM_FLOAT32_MATMUL_PRECISION=high"
# Flags from the vLLM recipe: block size 128 is mandatory for the sparse attention index cache.
export VLLM_EXTRA_ARGS="--block-size 128 --disable-hybrid-kv-cache-manager --moe-backend marlin --tool-call-parser minimax_m3 --enable-auto-tool-choice --reasoning-parser minimax_m3"
