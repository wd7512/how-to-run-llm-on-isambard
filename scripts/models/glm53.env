# GLM-5.3-Flash (zai-org): MoE with 288 routed experts, FP8, 328 GB, 1M context.
export MODEL_REPO="zai-org/GLM-5.3-Flash"
export SERVED_NAME="glm53"
export ARCH="Glm5NextForConditionalGeneration"
export MAX_LEN=262144
# Parsers from the vLLM recipe for this model. (The recipe's glm5_next tokenizer mode needs the
# Rust frontend, so we leave the tokenizer on auto.)
export VLLM_EXTRA_ARGS="--tool-call-parser glm47 --enable-auto-tool-choice --reasoning-parser glm47 --disable-flashinfer-autotune"
