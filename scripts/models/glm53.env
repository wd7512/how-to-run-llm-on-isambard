# GLM-5.3-Flash (zai-org): MoE with 288 routed experts, FP8, 328 GB, 1M context.
export MODEL_REPO="zai-org/GLM-5.3-Flash"
export SERVED_NAME="glm53"
export ARCH="Glm5NextForConditionalGeneration"
export MAX_LEN=262144
# Layout: NODES x (DP_PER_NODE replicas of TP GPUs each); EP=1 adds expert parallelism (MoE).
export NODES=2 TP=4 DP_PER_NODE=1 EP=1
export GPUS=4          # GPUs per node to request (billing is per GPU); must equal TP x DP_PER_NODE
# Parsers from the vLLM recipe for this model. (The recipe's glm5_next tokenizer mode needs the
# Rust frontend, so we leave the tokenizer on auto.)
# --enforce-eager: with CUDA graphs on, DP2 x TP4 + EP hung at graph capture 12/19 (22 min, no error).
export VLLM_EXTRA_ARGS="--tool-call-parser glm47 --enable-auto-tool-choice --reasoning-parser glm47 --disable-flashinfer-autotune --enforce-eager"
