# Flint (RecursiveSI/flint): 39.8B MoE, ~2.5B active, 256 experts, bf16, 79.6 GB, 262k context.
# NOTE: this is the BF16 base of OsaurusAI/Flint-40B-A2.5B-JANGH2. The JANGH2 checkpoint itself is an
# MLX / Apple-Silicon format that vLLM cannot load, so we serve the unquantised original instead.
# 79.6 GB leaves too little KV cache on one 96 GiB GPU, so shard over a node: tensor-parallel 4.
export MODEL_REPO="RecursiveSI/flint"
export SERVED_NAME="flint"
export ARCH="FlintForCausalLM"
export MAX_LEN=262144
export NODES=1 TP=4 DP_PER_NODE=1 EP=1
# vLLM picks FLASH_ATTN by default, but the Flint model code asserts FlashInfer attention.
export VLLM_EXTRA_ARGS="--attention-backend FLASHINFER"
