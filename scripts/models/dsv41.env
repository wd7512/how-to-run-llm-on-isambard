# DeepSeek-V4.1-Flash-1017: 552B MoE, FP8 + FP4 experts, 510 GB, 1M context.
export MODEL_REPO="deepseek-ai/DeepSeek-V4.1-Flash-1017"
export MODEL_REVISION="08c8657f02291e11b6f6b63e0e16014f8e748518"   # pinned commit; the weights we benchmarked
export SERVED_NAME="dsv41"
export ARCH="DeepseekV41ForCausalLM"        # checked against vLLM's registry in step 2
export MAX_LEN=262144
# Layout: NODES x (DP_PER_NODE replicas of TP GPUs each); EP=1 adds expert parallelism (MoE).
export NODES=2 TP=4 DP_PER_NODE=1 EP=1
export TIME_LIMIT=00:18:00   # hard cap on the serve job: 2.5x the measured job time
export STARTUP_DEADLINE_S=700   # abort if the server is not up by then: 2.5x the measured start-up
export GPUS=4          # GPUs PER NODE to request (billing is per GPU); must equal TP x DP_PER_NODE
# Parsers (reasoning and tools) so the reply has the thinking in `reasoning`, not inline.
export VLLM_EXTRA_ARGS="--trust-remote-code --tool-call-parser deepseek_v41 --enable-auto-tool-choice --reasoning-parser deepseek_v41"
