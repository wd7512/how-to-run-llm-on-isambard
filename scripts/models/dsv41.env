# DeepSeek-V4.1-Flash-1017: 552B MoE, FP8 + FP4 experts, 510 GB, 1M context.
export MODEL_REPO="deepseek-ai/DeepSeek-V4.1-Flash-1017"
export SERVED_NAME="dsv41"
export ARCH="DeepseekV41ForCausalLM"        # checked against vLLM's registry in step 2
export MAX_LEN=262144
# Layout: NODES x (DP_PER_NODE replicas of TP GPUs each); EP=1 adds expert parallelism (MoE).
export NODES=2 TP=4 DP_PER_NODE=1 EP=1
export VLLM_EXTRA_ARGS="--trust-remote-code"
